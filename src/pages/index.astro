---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import data from '../data/plugins.json';

const sample = `// Runs at evaluation time, against your real account.
local aws = import "@c6fc/spellcraft-aws-auth/module.libsonnet";
local s3  = import "@c6fc/spellcraft-aws-s3/module.libsonnet";

local account = aws.getCallerIdentity().Account;

{
  "main.tf.json": {
    resource: s3.bucket("artifacts-%s" % account, {
      versioned: true,
    }),
  },
}`;

const reasons = [
	{
		numeral: 'I',
		title: 'Modules don’t resolve dependencies',
		body: 'A module cannot declare that it needs another module at a version. Plugins are npm packages, so <code>npm install</code> does what it already does everywhere else in your stack — including transitively.'
	},
	{
		numeral: 'II',
		title: 'There is no runtime before apply',
		body: 'Enabling the API a resource depends on has to happen first. Plugins coordinate on lifecycle events, so the bootstrap runs itself rather than living in a README as step zero.'
	},
	{
		numeral: 'III',
		title: 'HCL cannot reach out',
		body: '<code>count</code> and <code>for_each</code> are not a programming language. Jsonnet composes properly, and native functions call real APIs while the configuration is being evaluated.'
	}
];
---

<Base
	title="SpellCraft — configuration that discovers its own context"
	description="SpellCraft evaluates Jsonnet with live cloud APIs in reach, then emits plain Terraform JSON. Account IDs, buckets and enabled services are discovered, not pasted in."
	active="home"
>
	<section class="hero">
		<p class="eyebrow">Infrastructure orchestration</p>
		<h1>Your config shouldn’t need a human to look things up first.</h1>

		<div class="hero-body">
			<div>
				<p class="lead">SpellCraft evaluates Jsonnet with live cloud APIs in reach, then emits plain Terraform JSON. Account IDs, existing buckets and enabled services are discovered while the configuration renders.</p>
				<p class="sub">It does not replace Terraform and owns no state of its own. Adoption is incremental, and reversible: delete SpellCraft tomorrow and your infrastructure is exactly where you left it.</p>
				<div class="cta">
					<a class="button" href="/docs/installation.html">Start reading</a>
					<code class="install">npm init spellcraft my-infra</code>
				</div>
			</div>

			<figure class="figure">
				<figcaption>Figure 1 — What runs when</figcaption>
				<svg viewBox="0 0 420 226" role="img" aria-label="A manifest is evaluated by SpellFrame, which calls AWS and GCP live and returns real values, producing ordinary Terraform JSON.">
					<defs>
						<marker id="arw" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
							<path d="M0 0 L7 3 L0 6 z" fill="var(--accent)" />
						</marker>
					</defs>
					<rect x="1" y="1" width="150" height="52" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
					<text x="16" y="24" class="d-mono">manifest.jsonnet</text>
					<text x="16" y="41" class="d-note">what you write</text>

					<line x1="151" y1="27" x2="256" y2="27" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#arw)" />
					<text x="166" y="20" class="d-note">evaluate</text>

					<rect x="266" y="1" width="153" height="52" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
					<text x="281" y="24" class="d-mono">SpellFrame</text>
					<text x="281" y="41" class="d-note">plugins loaded</text>

					<line x1="342" y1="53" x2="342" y2="86" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#arw)" />
					<rect x="266" y="96" width="153" height="52" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
					<text x="281" y="119" class="d-mono">AWS / GCP</text>
					<text x="281" y="136" class="d-note">live, at render time</text>

					<line x1="266" y1="122" x2="158" y2="122" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#arw)" />
					<text x="176" y="115" class="d-note">real values</text>

					<line x1="76" y1="53" x2="76" y2="176" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#arw)" />
					<rect x="1" y="186" width="418" height="39" fill="var(--ink)" />
					<text x="16" y="211" class="d-mono d-inv">render/main.tf.json — ordinary Terraform</text>
				</svg>
			</figure>
		</div>
	</section>

	<section class="split">
		<div class="split-aside">
			<h2>A whole spell fits on a screen.</h2>
			<p>Top-level keys are filenames. Values are the file contents. That is the entire model — and the account number in this bucket name was never typed by anyone.</p>
		</div>
		<div class="codeblock">
			<div class="filename">manifest.jsonnet</div>
			<Code code={sample} lang="jsonnet" theme="github-light" />
		</div>
	</section>

	<section class="band">
		<h2>Why not just write more Terraform modules?</h2>
		<p class="band-sub">Because three of the things you want from a module are not things a module can do.</p>
		<div class="reasons">
			{reasons.map((reason) => (
				<div>
					<div class="numeral">{reason.numeral}.</div>
					<h3>{reason.title}</h3>
					<p set:html={reason.body} />
				</div>
			))}
		</div>
	</section>

	<section class="band">
		<div class="band-head">
			<h2>The standard library</h2>
			<a href="/plugins.html">All {data.plugins.length} plugins →</a>
		</div>
		<div class="library">
			{data.plugins.map((plugin) => (
				<a class="lib-row" href="/plugins.html">
					<code>{plugin.short}</code>
					<span>{plugin.description}</span>
				</a>
			))}
			<a class="lib-row" href="/docs/plugin-contract.html">
				<code class="own">write your own</code>
				<span>npm init spellcraft-module</span>
			</a>
		</div>
	</section>
</Base>

<style>
	.hero { padding-block: clamp(48px, 7vw, 76px) 56px; border-bottom: 1px solid var(--rule); }
	.hero h1 {
		font-size: clamp(34px, 5.4vw, 60px);
		line-height: 1.06;
		letter-spacing: -0.025em;
		margin: 26px 0 28px;
		max-width: 17ch;
		text-wrap: balance;
	}
	.hero-body { display: flex; gap: 64px; align-items: flex-start; }
	.hero-body > div { flex: 1 1 420px; min-width: 0; }
	.lead {
		font-family: var(--display);
		font-size: clamp(17px, 2vw, 20px);
		line-height: 1.62;
		color: var(--ink-2);
		margin: 0 0 20px;
		max-width: 44ch;
	}
	.sub { font-size: 16px; line-height: 1.65; color: var(--muted); margin: 0 0 32px; max-width: 50ch; }
	.cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
	.install {
		font-size: 14px;
		color: var(--ink-2);
		border-bottom: 2px solid rgba(163, 68, 38, 0.35);
		padding-bottom: 3px;
	}

	/* Shares the row rather than sitting at a fixed 480px, so the diagram grows
	   with the window instead of stranding whitespace beside it. */
	.figure { flex: 1 1 440px; min-width: 0; margin: 0; background: var(--paper-3); border: 1px solid var(--rule); padding: 28px; }
	.figure figcaption {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
		margin-bottom: 20px;
	}
	.figure svg { width: 100%; height: auto; display: block; }
	.figure :global(.d-mono) { font-family: var(--mono); font-size: 12px; fill: var(--ink); }
	.figure :global(.d-note) { font-family: var(--sans); font-size: 11.5px; fill: var(--faint); }
	.figure :global(.d-inv) { fill: var(--paper); }

	.split { display: flex; gap: 56px; align-items: flex-start; padding-block: 56px; border-bottom: 1px solid var(--rule); }
	.split-aside { flex: 0 0 300px; }
	.split-aside h2 { font-size: 30px; margin: 0 0 14px; line-height: 1.2; }
	.split-aside p { font-size: 16px; line-height: 1.65; color: var(--muted); margin: 0; }
	.split .codeblock { flex: 1 1 0; min-width: 0; margin: 0; }

	.band { padding-block: 56px; border-bottom: 1px solid var(--rule); }
	.band:last-of-type { border-bottom: 0; }
	.band h2 { font-size: clamp(26px, 3.4vw, 32px); margin: 0 0 10px; }
	.band-sub { font-size: 16.5px; color: var(--muted); margin: 0 0 40px; max-width: 60ch; }
	.band-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; justify-content: space-between; margin-bottom: 28px; }
	.band-head h2 { margin: 0; }
	.band-head a { font-size: 15.5px; }

	.reasons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px; }
	.numeral { font-family: var(--display); font-size: 34px; font-weight: 700; color: var(--accent); line-height: 1; margin-bottom: 14px; }
	.reasons h3 { font-size: 19px; font-weight: 600; margin: 0 0 10px; }
	.reasons p { font-size: 15px; line-height: 1.68; color: var(--body); margin: 0; }

	.library { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 56px; }
	.lib-row {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding: 13px 0;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-size: 14.5px;
	}
	.lib-row:hover { color: var(--ink); }
	.lib-row:hover code { color: var(--accent); }
	.lib-row code { font-size: 14px; color: var(--ink); font-weight: 500; flex: 0 0 auto; }
	.lib-row code.own { color: var(--accent); }
	.lib-row span { text-align: right; }

	@media (max-width: 1000px) {
		.hero-body, .split { flex-direction: column; gap: 36px; }
		.figure { flex: 1 1 auto; width: 100%; }
		.split-aside { flex: 1 1 auto; }
		.reasons { grid-template-columns: 1fr; gap: 32px; }
		.library { grid-template-columns: 1fr; }
	}
</style>
