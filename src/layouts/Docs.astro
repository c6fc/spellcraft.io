---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const { entry, headings } = Astro.props;

const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

// Group into the parts the sidebar prints, preserving order.
const parts = [];
for (const doc of all) {
	let part = parts.find((p) => p.name === doc.data.part);
	if (!part) parts.push((part = { name: doc.data.part, docs: [] }));
	part.docs.push(doc);
}

const index = all.findIndex((doc) => doc.id === entry.id);
const previous = all[index - 1];
const next = all[index + 1];

const title = `${entry.data.title} — SpellCraft`;
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={entry.data.description} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={entry.data.description} />
	<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,600;7..72,700&family=Source+Sans+3:wght@400;500;600&family=Source+Code+Pro:wght@400;500&display=swap" />
</head>
<body>
	<Nav active="docs" />

	<div class="shell">
		<aside class="side">
			{parts.map((part) => (
				<div class="part">
					<div class="part-name">{part.name}</div>
					<div class="part-links">
						{part.docs.map((doc) => (
							<a
								href={`/docs/${doc.id}.html`}
								class={doc.id === entry.id ? 'here' : ''}
							>{doc.data.title}</a>
						))}
					</div>
				</div>
			))}
		</aside>

		<article class="article">
			<p class="eyebrow">{entry.data.part} · Chapter {entry.data.chapter}</p>
			<h1>{entry.data.title}</h1>
			<p class="standfirst">{entry.data.description}</p>
			<div class="dinkus"></div>

			<div class="prose">
				<slot />
			</div>

			<nav class="pager">
				{previous ? (
					<a class="prev" href={`/docs/${previous.id}.html`}>
						<span>Previous</span>
						<strong>{previous.data.title}</strong>
					</a>
				) : <span class="prev-empty"></span>}
				{next && (
					<a class="next" href={`/docs/${next.id}.html`}>
						<span>Next</span>
						<strong>{next.data.title}</strong>
					</a>
				)}
			</nav>
		</article>

		<aside class="toc">
			{headings.length > 0 && (
				<>
					<div class="toc-name">In this chapter</div>
					<div class="toc-links">
						{headings.filter((h) => h.depth === 2).map((h) => (
							<a href={`#${h.slug}`}>{h.text}</a>
						))}
					</div>
				</>
			)}
		</aside>
	</div>

	<Footer />
</body>
</html>

<style>
	.shell { display: flex; align-items: flex-start; }

	.side {
		flex: 0 0 258px;
		align-self: stretch;
		border-right: 1px solid var(--rule);
		background: var(--paper-2);
		padding: 34px 26px 60px;
		position: sticky;
		top: 0;
		max-height: 100vh;
		overflow-y: auto;
	}
	.part { margin-bottom: 28px; }
	.part-name {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fainter);
		margin-bottom: 13px;
	}
	.part-links { display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
	.part-links a { color: var(--ink-2); }
	.part-links a:hover { color: var(--accent); }
	.part-links a.here { color: var(--accent); font-weight: 600; }

	.article { flex: 1 1 0; min-width: 0; padding: 48px clamp(24px, 4vw, 60px) 80px; max-width: 900px; }
	.article h1 { font-size: clamp(32px, 4.4vw, 44px); margin: 16px 0 20px; line-height: 1.1; }
	.standfirst {
		font-family: var(--display);
		font-size: 19.5px;
		line-height: 1.62;
		color: var(--ink-2);
		margin: 0 0 34px;
	}
	.dinkus { height: 2px; width: 56px; background: var(--ink); margin-bottom: 34px; }

	.pager { display: flex; gap: 14px; border-top: 1px solid var(--rule); padding-top: 24px; margin-top: 48px; }
	.pager a { flex: 1 1 0; padding: 6px 16px; }
	.pager .prev, .pager .prev-empty { flex: 1 1 0; }
	.pager .prev { border-left: 2px solid var(--accent); }
	.pager .next { border-right: 2px solid var(--accent); text-align: right; }
	.pager span { display: block; font-size: 12.5px; color: var(--faint); margin-bottom: 3px; }
	.pager strong { font-family: var(--display); font-size: 16.5px; font-weight: 600; color: var(--ink); }

	.toc { flex: 0 0 194px; padding: 48px 30px 60px; position: sticky; top: 0; }
	.toc-name {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fainter);
		margin-bottom: 14px;
	}
	.toc-links { display: flex; flex-direction: column; gap: 11px; font-size: 14px; }
	.toc-links a { color: var(--muted); }
	.toc-links a:hover { color: var(--accent); }

	@media (max-width: 1180px) {
		.toc { display: none; }
	}
	@media (max-width: 860px) {
		.shell { flex-direction: column; }
		.side {
			position: static;
			max-height: none;
			flex: 1 1 auto;
			width: 100%;
			border-right: 0;
			border-bottom: 1px solid var(--rule);
			padding-block: 24px;
		}
		.article { padding-inline: var(--gutter); }
	}
</style>
